#!/usr/bin/env bash
# Install and configure HAProxy load balancer

set -e

apt-get update
apt-get install -y haproxy

# Configure backend hostname resolution
if ! grep -q "35.176.96.139.*7334-web-01" /etc/hosts; then
    echo "35.176.96.139 7334-web-01 web-01" >> /etc/hosts
fi

if ! grep -q "35.176.161.100.*7334-web-02" /etc/hosts; then
    echo "35.176.161.100 7334-web-02 web-02" >> /etc/hosts
fi

# Configure HAProxy
cat > /etc/haproxy/haproxy.cfg <<'EOF'
global
        log /dev/log local0
        log /dev/log local1 notice
        chroot /var/lib/haproxy
        stats socket /run/haproxy/admin.sock mode 660 level admin
        stats timeout 30s
        user haproxy
        group haproxy
        daemon

defaults
        log global
        mode http
        option httplog
        option dontlognull
        timeout connect 5000
        timeout client 50000
        timeout server 50000

frontend http_front
        bind *:80
        default_backend web_servers

backend web_servers
        balance roundrobin
        server web-01 7334-web-01:80 check
        server web-02 7334-web-02:80 check
EOF

# Validate and start HAProxy
haproxy -c -f /etc/haproxy/haproxy.cfg
systemctl enable haproxy
service haproxy restart

